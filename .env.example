# ─────────────────────────────────────────────────────────────────────────────
# SV-Platform environment — copy to .env and fill in.
# Nothing here is secret in the repo; real secrets live only in your local .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# The bare domain. Root serves the SV-FFM homepage; the app lives on archiv.<domain>.
APP_DOMAIN=sv-fwsffm.de
# Public base URL of the Next.js app (archiv subdomain in prod, localhost in dev).
APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=sv
POSTGRES_PASSWORD=sv_local_dev
POSTGRES_DB=svplatform
# For host-run dev + prisma CLI use localhost. Inside docker-compose this is
# overridden to host "postgres" automatically.
DATABASE_URL=postgresql://sv:sv_local_dev@localhost:5432/svplatform?schema=public

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 33
AUTH_SECRET=replace-me-with-a-random-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated bootstrap admins. First login of these emails auto-creates an ADMIN user.
ADMIN_EMAILS=deine-adresse@example.com

# ── File uploads (protocol PDFs) ─────────────────────────────────────────────
# Local dev: a folder in the repo. In docker/prod: the mounted volume /var/sv/uploads.
UPLOADS_DIR=./data-uploads

# ── OpenAI (smart mail classification) ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Mail (Zoho IMAP + SMTP on the custom domain) ─────────────────────────────
# Master switch: keep false until IMAP/OpenAI/Slack creds exist. The worker
# starts, logs "idle", and does nothing when disabled.
MAILBRAIN_ENABLED=false
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993
IMAP_USER=sv@sv-fwsffm.de
IMAP_PASSWORD=
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=sv@sv-fwsffm.de
SMTP_PASSWORD=
MAIL_POLL_INTERVAL_MS=180000
# Hours a mail may sit unacknowledged before it is escalated to the Schulsprecher.
ESCALATION_HOURS=4

# ── Slack (routing + notifications) ──────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_INBOX_CHANNEL=#eingang

# ── Google Drive (document sharing) ──────────────────────────────────────────
# Path to the service-account JSON file, OR the JSON inlined as a single line.
# Reuse the existing SV-Archiv service account.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/drive-service-account.json

# ── Shared calendar ──────────────────────────────────────────────────────────
# Token that protects the internal iCal feed (public events need no token).
# Must be at least 16 characters — a shorter or placeholder value keeps the
# internal feed disabled. Generate with: openssl rand -hex 32
CALENDAR_FEED_TOKEN=replace-me
